# Пример переменных окружения шлюза и MCP-процесса 1cmcp.
# Скопируйте в .env в корне репозитория и подставьте свои значения.
# Файл .env в git не коммитится.

# Корень слоя A. Мок: http://127.0.0.1:18080
# Живая 1С: http(s)://{host}/{ib}/hs/mcp   (без /v1)
ONEC_BASE_URL=http://127.0.0.1:18080

# Секрет клиента интеграции. На моке стендовый токен: dev-token
# На живой 1С — plaintext токена, не SHA-256 (хеш хранится только в справочнике 1С).
ONEC_TOKEN=dev-token

ONEC_TIMEOUT_SECONDS=30
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
TENANT=default

# Кэш ответов /v1/meta на шлюзе, секунды. 0 — не кэшировать.
META_CACHE_TTL_SECONDS=60

# Пресет типовой конфигурации для подсказок meta_search и инструмента guide:
# auto | ut11 | ka2 | erp2 | bp30 | none
ONEC_PRESET=auto
