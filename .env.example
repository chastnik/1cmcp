# Первый старт шлюза 1cmcp. Скопируйте в .env (в git не коммитится).
# Перед правкой .env сделайте копию.
# Лицензионный ключ продукта 1cmcp не требуется.

# Bind процесса serve. Дальше — веб-консоль http://127.0.0.1:8000
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Каталог console.json: базы 1С, операторы, настройки шлюза.
GATEWAY_DATA_DIR=./data

# Токен первого входа в админку консоли. После заведения оператора —
# входите логином. Токен оставьте как аварийный ключ.
ADMIN_BOOTSTRAP_TOKEN=change-me

# Необязательное семя на самый первый запуск, пока в консоли ещё нет баз.
# Дальше URL и токены баз задаются в Администрирование → Базы 1С.
# ONEC_BASE_URL=http://127.0.0.1:18080
# ONEC_TOKEN=dev-token
