#Область ПрограммныйИнтерфейс

// Валидирует и выполняет именованный или произвольный запрос.
//
// Параметры:
//  ТелоJSON - Строка
//
// Возвращаемое значение:
//  Структура - КодСостояния (Число), Тело (Произвольный)
//
Функция ВыполнитьПоТелу(ТелоJSON) Экспорт

	Данные = ПрочитатьТело(ТелоJSON);
	Если Данные = Неопределено Тогда
		Возврат Ошибка(400, "bad_request", "Некорректный JSON");
	КонецЕсли;

	Имя = Поле(Данные, "named_query");
	Текст = Поле(Данные, "text");
	Если ЗначениеЗаполнено(Имя) И ЗначениеЗаполнено(Текст) Тогда
		Возврат Ошибка(400, "bad_request", "Укажите либо named_query, либо text");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Имя) И Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Ошибка(400, "bad_request", "Нужен named_query или text");
	КонецЕсли;

	Лимит = 1000;
	ЗначениеЛимита = Поле(Данные, "limit");
	Если ЗначениеЛимита <> Неопределено Тогда
		Лимит = Число(ЗначениеЛимита);
	КонецЕсли;
	Если Лимит < 1 Или Лимит > 10000 Тогда
		Возврат Ошибка(400, "query_rejected", "Лимит строк должен быть от 1 до 10000");
	КонецЕсли;

	ПараметрыЗапроса = Новый Соответствие;
	СырыеПараметры = Поле(Данные, "parameters");
	Если ТипЗнч(СырыеПараметры) = Тип("Соответствие") Тогда
		ПараметрыЗапроса = СырыеПараметры;
	ИначеЕсли ТипЗнч(СырыеПараметры) = Тип("Структура") Тогда
		Для Каждого КлючЗначение Из СырыеПараметры Цикл
			ПараметрыЗапроса.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	Если ЗначениеЗаполнено(Имя) Тогда
		Элемент = НайтиИменованный(Строка(Имя));
		Если Элемент = Неопределено Тогда
			Возврат Ошибка(404, "not_found", "Нет именованного запроса " + Имя);
		КонецЕсли;
		ТекстЗапроса = Элемент.ТекстЗапроса;
		Если Элемент.ЛимитСтрок > 0 И Элемент.ЛимитСтрок < Лимит Тогда
			Лимит = Элемент.ЛимитСтрок;
		КонецЕсли;
	Иначе
		ТекстЗапроса = Строка(Текст);
	КонецЕсли;

	ОшибкаВалидации = ПроверитьТекстВыборки(ТекстЗапроса);
	Если ОшибкаВалидации <> Неопределено Тогда
		Возврат Ошибка(400, "query_rejected", ОшибкаВалидации);
	КонецЕсли;

	Попытка
		Результат = ВыполнитьВыборку(ТекстЗапроса, ПараметрыЗапроса, Лимит);
	Исключение
		Возврат Ошибка(400, "query_rejected", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если ЗначениеЗаполнено(Имя) Тогда
		Результат.Вставить("named_query", Строка(Имя));
	КонецЕсли;
	Возврат Успех(Результат);

КонецФункции

// Возвращает Неопределено, если текст допустим, иначе текст ошибки.
Функция ПроверитьТекстВыборки(Текст) Экспорт

	Если ПустаяСтрока(СокрЛП(Строка(Текст))) Тогда
		Возврат "Нужен текст запроса или имя именованного запроса";
	КонецЕсли;
	Если СтрДлина(Текст) > 20000 Тогда
		Возврат "Текст запроса слишком длинный";
	КонецЕсли;
	Очищенный = УбратьКомментарии(Текст);
	Компакт = СокрЛП(СтрЗаменить(СтрЗаменить(Очищенный, Символы.ПС, " "), Символы.Таб, " "));
	Пока СтрНайти(Компакт, "  ") > 0 Цикл
		Компакт = СтрЗаменить(Компакт, "  ", " ");
	КонецЦикла;
	Если ПустаяСтрока(Компакт) Тогда
		Возврат "После удаления комментариев запрос пуст";
	КонецЕсли;
	Первое = НРег(ПервоеСлово(Компакт));
	Если Первое <> "выбрать" И Первое <> "select" Тогда
		Возврат "Разрешена только выборка: запрос должен начинаться с ВЫБРАТЬ или SELECT";
	КонецЕсли;
	Нижний = НРег(Компакт);
	Запреты = СтрРазделить(
		";,выполнить,execute,уничтожить,drop,удалить,delete,поместить,into,insert,update,merge,exec",
		",",
		Ложь);
	Для Каждого Запрет Из Запреты Цикл
		Если СтрНайти(Нижний, СокрЛП(Запрет)) > 0 Тогда
			Возврат "Запрос содержит запрещённую конструкцию";
		КонецЕсли;
	КонецЦикла;
	Если СтрНайти(Нижний, "для изменения") > 0 Или СтрНайти(Нижний, "for update") > 0 Тогда
		Возврат "Запрос содержит запрещённую конструкцию";
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиИменованный(Имя)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Запросы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.мкпИменованныеЗапросы КАК Запросы
	|ГДЕ
	|	Запросы.Наименование = &Имя
	|	И Запросы.Активен
	|	И Не Запросы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Имя", Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ВыполнитьВыборку(ТекстЗапроса, ПараметрыЗапроса, Лимит)

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Для Каждого КлючЗначение Из ПараметрыЗапроса Цикл
		Запрос.УстановитьПараметр(Строка(КлючЗначение.Ключ), КлючЗначение.Значение);
	КонецЦикла;
	Таблица = Запрос.Выполнить().Выгрузить();
	Колонки = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	Строки = Новый Массив;
	Счётчик = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если Счётчик >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Ряд = Новый Массив;
		Для Каждого ИмяКолонки Из Колонки Цикл
			Ряд.Добавить(мкпСериализация.ЗначениеВJSON(СтрокаТаблицы[ИмяКолонки]));
		КонецЦикла;
		Строки.Добавить(Ряд);
		Счётчик = Счётчик + 1;
	КонецЦикла;
	Возврат Новый Структура("content_kind,columns,rows", "data", Колонки, Строки);

КонецФункции

Функция Поле(Данные, Имя)

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Данные.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Возврат Данные.Получить(Имя);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция УбратьКомментарии(Текст)

	Результат = Текст;
	Пока Истина Цикл
		Начало = СтрНайти(Результат, "/*");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Конец = СтрНайти(Результат, "*/", , Начало + 2);
		Если Конец = 0 Тогда
			Результат = Лев(Результат, Начало - 1);
			Прервать;
		КонецЕсли;
		Результат = Лев(Результат, Начало - 1) + " " + Сред(Результат, Конец + 2);
	КонецЦикла;
	Строки = СтрРазделить(Результат, Символы.ПС, Истина);
	Чистые = Новый Массив;
	Для Каждого СтрокаТекста Из Строки Цикл
		Поз = СтрНайти(СтрокаТекста, "//");
		Если Поз > 0 Тогда
			Чистые.Добавить(Лев(СтрокаТекста, Поз - 1));
		Иначе
			Чистые.Добавить(СтрокаТекста);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Чистые, " ");

КонецФункции

Функция ПервоеСлово(Текст)

	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Не ЭтоБукваИлиЦифра(Символ) Тогда
			Возврат Лев(Текст, Индекс - 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;

КонецФункции

Функция ЭтоБукваИлиЦифра(Символ)

	Код = КодСимвола(Символ);
	Возврат (Код >= 48 И Код <= 57)
		Или (Код >= 65 И Код <= 90)
		Или (Код >= 97 И Код <= 122)
		Или (Код >= 1040 И Код <= 1103)
		Или Код = 1025 Или Код = 1105
		Или Символ = "_";

КонецФункции

Функция ПрочитатьТело(ТелоJSON)

	Если ПустаяСтрока(СокрЛП(Строка(ТелоJSON))) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Попытка
		Возврат мкпСериализация.ИзJSON(ТелоJSON);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция Успех(Тело)

	Возврат Новый Структура("КодСостояния,Тело", 200, Тело);

КонецФункции

Функция Ошибка(КодСостояния, КодОшибки, Подробность)

	Возврат Новый Структура("КодСостояния,КодОшибки,Подробность", КодСостояния, КодОшибки, Подробность);

КонецФункции

#КонецОбласти
