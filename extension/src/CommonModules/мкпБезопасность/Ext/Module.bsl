#Область ПрограммныйИнтерфейс

Функция ЭтоСлужебныйОбъект(Имя) Экспорт

	Возврат СтрНачинаетсяС(Строка(Имя), "мкп");

КонецФункции

Функция КлиентПоЗапросу(Запрос) Экспорт

	Заголовок = Запрос.Заголовки.Получить("Authorization");
	Если Заголовок = Неопределено Тогда
		Заголовок = Запрос.Заголовки.Получить("authorization");
	КонецЕсли;
	Если Заголовок = Неопределено Или Не СтрНачинаетсяС(Заголовок, "Bearer ") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Токен = СокрЛП(Сред(Заголовок, 8));
	Если ПустаяСтрока(Токен) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат КлиентПоХешу(мкпСериализация.ХешТокена(Токен));

КонецФункции

Функция ЕстьСкоуп(Клиент, НужныйСкоуп) Экспорт

	Если Клиент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Список = СтрРазделить(Строка(Клиент.Скоупы), ",", Ложь);
	Для Каждого Элемент Из Список Цикл
		Если СокрЛП(Элемент) = НужныйСкоуп Или СокрЛП(Элемент) = "*" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция Разрешено(Клиент, ВидОбъекта, ИмяОбъекта, Операция) Экспорт

	Если Клиент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЭтоСлужебныйОбъект(ИмяОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Разрешено КАК Разрешено,
	|	Правила.Поля КАК Поля
	|ИЗ
	|	РегистрСведений.мкпПравилаДоступа КАК Правила
	|ГДЕ
	|	Правила.Клиент = &Клиент";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Операция = "read";
	КонецЕсли;
	ЗапросТочный = Новый Запрос;
	ЗапросТочный.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Правила.Разрешено КАК Разрешено
	|ИЗ
	|	РегистрСведений.мкпПравилаДоступа КАК Правила
	|ГДЕ
	|	Правила.Клиент = &Клиент
	|	И Правила.ВидОбъекта = &Вид
	|	И Правила.ИмяОбъекта = &Имя
	|	И Правила.Операция = &Операция";
	ЗапросТочный.УстановитьПараметр("Клиент", Клиент);
	ЗапросТочный.УстановитьПараметр("Вид", ВидОбъекта);
	ЗапросТочный.УстановитьПараметр("Имя", ИмяОбъекта);
	ЗапросТочный.УстановитьПараметр("Операция", Операция);
	Выборка = ЗапросТочный.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Разрешено = Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Процедура ЗаписатьВызов(Клиент, Метод, Путь, КодОтвета, ДлительностьМс) Экспорт

	Запись = РегистрыСведений.мкпЖурналВызовов.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Строка(Новый УникальныйИдентификатор);
	Запись.Клиент = Клиент;
	Запись.Метод = Метод;
	Запись.Путь = Путь;
	Запись.КодОтвета = КодОтвета;
	Запись.ДлительностьМс = ДлительностьМс;
	Запись.Момент = ТекущаяУниверсальнаяДата();
	Запись.Записать();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлиентПоХешу(Хеш)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Клиенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.мкпКлиентыИнтеграции КАК Клиенты
	|ГДЕ
	|	Клиенты.ХешТокена = &Хеш
	|	И Клиенты.Активен
	|	И НЕ Клиенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Хеш", Хеш);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

#КонецОбласти
