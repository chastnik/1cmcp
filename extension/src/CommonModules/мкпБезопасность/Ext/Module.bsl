#Область ПрограммныйИнтерфейс

Функция ЭтоСлужебныйОбъект(Имя) Экспорт

	Возврат СтрНачинаетсяС(Строка(Имя), "мкп");

КонецФункции

Функция КлиентПоЗапросу(Запрос) Экспорт

	Заголовок = Запрос.Заголовки.Получить("Authorization");
	Если Заголовок = Неопределено Тогда
		Заголовок = Запрос.Заголовки.Получить("authorization");
	КонецЕсли;
	Если Заголовок = Неопределено Или Не СтрНачинаетсяС(Заголовок, "Bearer ") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Токен = СокрЛП(Сред(Заголовок, 8));
	Если ПустаяСтрока(Токен) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат КлиентПоХешу(мкпСериализация.ХешТокена(Токен));

КонецФункции

Функция ЕстьСкоуп(Клиент, НужныйСкоуп) Экспорт

	Если Клиент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Список = СтрРазделить(Строка(Клиент.Скоупы), ",", Ложь);
	Для Каждого Элемент Из Список Цикл
		Если СокрЛП(Элемент) = НужныйСкоуп Или СокрЛП(Элемент) = "*" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция Разрешено(Клиент, ВидОбъекта, ИмяОбъекта, Операция) Экспорт

	Если Клиент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЭтоСлужебныйОбъект(ИмяОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.Разрешено КАК Разрешено,
	|	Правила.Поля КАК Поля
	|ИЗ
	|	РегистрСведений.мкпПравилаДоступа КАК Правила
	|ГДЕ
	|	Правила.Клиент = &Клиент";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Операция = "read";
	КонецЕсли;
	ЗапросТочный = Новый Запрос;
	ЗапросТочный.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Правила.Разрешено КАК Разрешено
	|ИЗ
	|	РегистрСведений.мкпПравилаДоступа КАК Правила
	|ГДЕ
	|	Правила.Клиент = &Клиент
	|	И Правила.ВидОбъекта = &Вид
	|	И Правила.ИмяОбъекта = &Имя
	|	И Правила.Операция = &Операция";
	ЗапросТочный.УстановитьПараметр("Клиент", Клиент);
	ЗапросТочный.УстановитьПараметр("Вид", ВидОбъекта);
	ЗапросТочный.УстановитьПараметр("Имя", ИмяОбъекта);
	ЗапросТочный.УстановитьПараметр("Операция", Операция);
	Выборка = ЗапросТочный.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Разрешено = Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Процедура ЗаписатьВызов(Клиент, Метод, Путь, КодОтвета, ДлительностьМс, СсылкиJSON = "", Сессия = "") Экспорт

	Запись = РегистрыСведений.мкпЖурналВызовов.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = Строка(Новый УникальныйИдентификатор);
	Запись.Клиент = Клиент;
	Запись.Метод = Метод;
	Запись.Путь = Путь;
	Запись.КодОтвета = КодОтвета;
	Запись.ДлительностьМс = ДлительностьМс;
	Запись.Момент = ТекущаяУниверсальнаяДата();
	Запись.СсылкиJSON = СсылкиJSON;
	Запись.Сессия = Сессия;
	Запись.Записать();

КонецПроцедуры

Функция ЖурналКлиента(Клиент, ПараметрыЗапроса) Экспорт

	Лимит = 50;
	Если ПараметрыЗапроса <> Неопределено Тогда
		СыройЛимит = ПараметрыЗапроса.Получить("limit");
		Если СыройЛимит <> Неопределено Тогда
			Лимит = Число(СыройЛимит);
		КонецЕсли;
	КонецЕсли;
	Если Лимит < 1 Тогда
		Лимит = 1;
	КонецЕсли;
	Если Лимит > 200 Тогда
		Лимит = 200;
	КонецЕсли;
	Префикс = "";
	С = "";
	СессияФильтр = "";
	Если ПараметрыЗапроса <> Неопределено Тогда
		ЗначениеПути = ПараметрыЗапроса.Получить("path");
		Если ЗначениеПути <> Неопределено Тогда
			Префикс = Строка(ЗначениеПути);
		КонецЕсли;
		ЗначениеС = ПараметрыЗапроса.Получить("since");
		Если ЗначениеС <> Неопределено Тогда
			С = Строка(ЗначениеС);
		КонецЕсли;
		ЗначениеСессии = ПараметрыЗапроса.Получить("session");
		Если ЗначениеСессии <> Неопределено Тогда
			СессияФильтр = Строка(ЗначениеСессии);
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Журнал.Идентификатор КАК Идентификатор,
	|	Журнал.Метод КАК Метод,
	|	Журнал.Путь КАК Путь,
	|	Журнал.КодОтвета КАК КодОтвета,
	|	Журнал.ДлительностьМс КАК ДлительностьМс,
	|	Журнал.Момент КАК Момент,
	|	Журнал.СсылкиJSON КАК СсылкиJSON,
	|	Журнал.Сессия КАК Сессия
	|ИЗ
	|	РегистрСведений.мкпЖурналВызовов КАК Журнал
	|ГДЕ
	|	Журнал.Клиент = &Клиент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Момент УБЫВ";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	Элементы = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Элементы.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Путь = Строка(Выборка.Путь);
		Если Не ПустаяСтрока(Префикс) И Не СтрНачинаетсяС(Путь, Префикс) Тогда
			Продолжить;
		КонецЕсли;
		МоментТекст = Формат(Выборка.Момент, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z";
		Если Не ПустаяСтрока(С) И МоментТекст < С Тогда
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(СессияФильтр) И Строка(Выборка.Сессия) <> СессияФильтр Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЖурнала = Новый Структура;
		СтрокаЖурнала.Вставить("id", Строка(Выборка.Идентификатор));
		СтрокаЖурнала.Вставить("method", Строка(Выборка.Метод));
		СтрокаЖурнала.Вставить("path", Путь);
		СтрокаЖурнала.Вставить("status", Выборка.КодОтвета);
		СтрокаЖурнала.Вставить("duration_ms", Выборка.ДлительностьМс);
		СтрокаЖурнала.Вставить("at", МоментТекст);
		СтрокаЖурнала.Вставить("session_id", Строка(Выборка.Сессия));
		Ссылки = Новый Массив;
		Если Не ПустаяСтрока(Выборка.СсылкиJSON) Тогда
			Попытка
				Прочитано = мкпСериализация.ИзJSON(Выборка.СсылкиJSON);
				Если ТипЗнч(Прочитано) = Тип("Массив") Тогда
					Ссылки = Прочитано;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
		СтрокаЖурнала.Вставить("created_refs", Ссылки);
		Элементы.Добавить(СтрокаЖурнала);
	КонецЦикла;
	Страница = Новый Структура;
	Страница.Вставить("content_kind", "data");
	Страница.Вставить("items", Элементы);
	Возврат Страница;

КонецФункции

Функция ПроверитьЛимитыКлиента(Клиент, Элемент) Экспорт

	Сообщения = Новый Массив;
	Если Клиент = Неопределено Или Элемент = Неопределено Тогда
		Возврат Сообщения;
	КонецЕсли;
	ЛимитСуммы = 0;
	ЛимитКоличества = 0;
	Попытка
		ЛимитСуммы = Число(Клиент.ЛимитСуммы);
	Исключение
	КонецПопытки;
	Попытка
		ЛимитКоличества = Число(Клиент.ЛимитКоличества);
	Исключение
	КонецПопытки;
	Если ЛимитСуммы > 0 Тогда
		Сумма = ЧислоИзПоля(Элемент, "Amount");
		Если Сумма = Неопределено Тогда
			Сумма = ЧислоИзПоля(Элемент, "СуммаДокумента");
		КонецЕсли;
		Если Сумма = Неопределено Тогда
			Сумма = ЧислоИзПоля(Элемент, "Сумма");
		КонецЕсли;
		Если Сумма <> Неопределено И Сумма > ЛимитСуммы Тогда
			Сообщения.Добавить("Сумма " + Строка(Сумма) + " превышает лимит клиента интеграции (" + Строка(ЛимитСуммы) + ")");
		КонецЕсли;
	КонецЕсли;
	Если ЛимитКоличества > 0 Тогда
		Количество = КоличествоИзЭлемента(Элемент);
		Если Количество <> Неопределено И Количество > ЛимитКоличества Тогда
			Сообщения.Добавить("Количество " + Строка(Количество) + " превышает лимит клиента интеграции (" + Строка(ЛимитКоличества) + ")");
		КонецЕсли;
	КонецЕсли;
	Возврат Сообщения;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлиентПоХешу(Хеш)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Клиенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.мкпКлиентыИнтеграции КАК Клиенты
	|ГДЕ
	|	Клиенты.ХешТокена = &Хеш
	|	И Клиенты.Активен
	|	И НЕ Клиенты.ПометкаУдаления";
	Запрос.УстановитьПараметр("Хеш", Хеш);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ЧислоИзПоля(Элемент, ИмяПоля)

	Значение = Неопределено;
	Если ТипЗнч(Элемент) = Тип("Соответствие") Тогда
		Значение = Элемент.Получить(ИмяПоля);
	ИначеЕсли ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство(ИмяПоля) Тогда
		Значение = Элемент[ИмяПоля];
	КонецЕсли;
	Если Значение = Неопределено Или Значение = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция КоличествоИзЭлемента(Элемент)

	Итого = 0;
	Есть = Ложь;
	Для Каждого ИмяПоля Из СтрРазделить("Quantity,Количество", ",", Ложь) Цикл
		Значение = ЧислоИзПоля(Элемент, ИмяПоля);
		Если Значение <> Неопределено Тогда
			Итого = Итого + Значение;
			Есть = Истина;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяТаблицы Из СтрРазделить("Goods,Товары,Items", ",", Ложь) Цикл
		Строки = Неопределено;
		Если ТипЗнч(Элемент) = Тип("Соответствие") Тогда
			Строки = Элемент.Получить(ИмяТаблицы);
		ИначеЕсли ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство(ИмяТаблицы) Тогда
			Строки = Элемент[ИмяТаблицы];
		КонецЕсли;
		Если ТипЗнч(Строки) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаТЧ Из Строки Цикл
			Для Каждого ИмяПоля Из СтрРазделить("Quantity,Количество", ",", Ложь) Цикл
				Значение = ЧислоИзПоля(СтрокаТЧ, ИмяПоля);
				Если Значение <> Неопределено Тогда
					Итого = Итого + Значение;
					Есть = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Если Не Есть Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Итого;

КонецФункции

#КонецОбласти
