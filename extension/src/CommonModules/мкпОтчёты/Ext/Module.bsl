#Область ПрограммныйИнтерфейс

Функция ВыполнитьПоТелу(ТелоJSON) Экспорт

	Если ПустаяСтрока(СокрЛП(Строка(ТелоJSON))) Тогда
		Возврат Ошибка(400, "bad_request", "Нужно имя отчёта");
	КонецЕсли;
	Попытка
		Данные = мкпСериализация.ИзJSON(ТелоJSON);
	Исключение
		Возврат Ошибка(400, "bad_request", "Некорректный JSON");
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Ошибка(400, "bad_request", "Тело должно быть JSON-объектом");
	КонецЕсли;

	Имя = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные.Свойство("name", Имя);
	Иначе
		Имя = Данные.Получить("name");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат Ошибка(400, "bad_request", "Нужно имя отчёта");
	КонецЕсли;
	Если СтрНачинаетсяС(Строка(Имя), "мкп") Тогда
		Возврат Ошибка(404, "not_found", "Нет отчёта " + Имя);
	КонецЕсли;

	ФорматВывода = "json";
	Вариант = "";
	ПараметрыОтчёта = Новый Соответствие;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Данные.Свойство("format") И ЗначениеЗаполнено(Данные.format) Тогда
			ФорматВывода = НРег(Строка(Данные.format));
		КонецЕсли;
		Если Данные.Свойство("variant") Тогда
			Вариант = Строка(Данные.variant);
		КонецЕсли;
		Если Данные.Свойство("parameters") Тогда
			ПараметрыОтчёта = КакСоответствие(Данные.parameters);
		КонецЕсли;
	Иначе
		Если Данные.Получить("format") <> Неопределено Тогда
			ФорматВывода = НРег(Строка(Данные.Получить("format")));
		КонецЕсли;
		Если Данные.Получить("variant") <> Неопределено Тогда
			Вариант = Строка(Данные.Получить("variant"));
		КонецЕсли;
		Если Данные.Получить("parameters") <> Неопределено Тогда
			ПараметрыОтчёта = КакСоответствие(Данные.Получить("parameters"));
		КонецЕсли;
	КонецЕсли;
	Если ФорматВывода <> "json" И ФорматВывода <> "markdown" И ФорматВывода <> "csv" Тогда
		Возврат Ошибка(400, "bad_request", "format: json, markdown или csv");
	КонецЕсли;

	МетаОтчёт = Метаданные.Отчеты.Найти(Строка(Имя));
	Если МетаОтчёт = Неопределено Тогда
		Возврат Ошибка(404, "not_found", "Нет отчёта " + Имя);
	КонецЕсли;

	Попытка
		Таблица = Скомпоновать(МетаОтчёт, ПараметрыОтчёта, Вариант);
	Исключение
		Возврат Ошибка(400, "bad_request", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ТелоОтчёта = Новый Структура("name,variant,columns,rows,totals",
		Строка(Имя), Вариант, Таблица.Колонки, Таблица.Строки, Таблица.Итоги);
	Результат = Новый Структура("content_kind,format,body", "data", ФорматВывода, Неопределено);
	Если ФорматВывода = "json" Тогда
		Результат.body = ТелоОтчёта;
	ИначеЕсли ФорматВывода = "csv" Тогда
		Результат.body = ВCSV(Таблица);
	Иначе
		Результат.body = ВMarkdown(Таблица);
	КонецЕсли;
	Возврат Успех(Результат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Скомпоновать(МетаОтчёт, ПараметрыОтчёта, Вариант)

	ОтчётОбъект = Отчеты[МетаОтчёт.Имя].Создать();
	Схема = Неопределено;
	Попытка
		Схема = ОтчётОбъект.СхемаКомпоновкиДанных;
	Исключение
		Схема = Неопределено;
	КонецПопытки;
	Если Схема = Неопределено Тогда
		Схема = ОтчётОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	КонецЕсли;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Настройки = Схема.НастройкиПоУмолчанию;
	Если ЗначениеЗаполнено(Вариант) Тогда
		Для Каждого ЭлементВарианта Из Схема.ВариантыНастроек Цикл
			Если ЭлементВарианта.Имя = Вариант Или Строка(ЭлементВарианта.Представление) = Вариант Тогда
				Настройки = ЭлементВарианта.Настройки;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого КлючЗначение Из ПараметрыОтчёта Цикл
		ПараметрСКД = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(
			Новый ПараметрКомпоновкиДанных(Строка(КлючЗначение.Ключ)));
		Если ПараметрСКД <> Неопределено Тогда
			ПараметрСКД.Значение = КлючЗначение.Значение;
			ПараметрСКД.Использование = Истина;
		КонецЕсли;
	КонецЦикла;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		Схема,
		Настройки,
		,
		,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки);
	Таблица = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Таблица);
	ПроцессорВывода.Вывести(Процессор);
	Возврат ТаблицаВСтруктуру(Таблица);

КонецФункции

Функция ТаблицаВСтруктуру(Таблица)

	Колонки = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	Строки = Новый Массив;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Запись = Новый Структура;
		Для Каждого ИмяКолонки Из Колонки Цикл
			Запись.Вставить(ИмяКолонки, мкпСериализация.ЗначениеВJSON(СтрокаТаблицы[ИмяКолонки]));
		КонецЦикла;
		Строки.Добавить(Запись);
	КонецЦикла;
	Возврат Новый Структура("Колонки,Строки,Итоги", Колонки, Строки, Новый Структура);

КонецФункции

Функция ВCSV(Таблица)

	Части = Новый Массив;
	Части.Добавить(СтрСоединить(Таблица.Колонки, ","));
	Для Каждого СтрокаТаблицы Из Таблица.Строки Цикл
		Ячейки = Новый Массив;
		Для Каждого ИмяКолонки Из Таблица.Колонки Цикл
			Ячейки.Добавить(Строка(СтрокаТаблицы[ИмяКолонки]));
		КонецЦикла;
		Части.Добавить(СтрСоединить(Ячейки, ","));
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС) + Символы.ПС;

КонецФункции

Функция ВMarkdown(Таблица)

	Части = Новый Массив;
	Части.Добавить("| " + СтрСоединить(Таблица.Колонки, " | ") + " |");
	Разделитель = Новый Массив;
	Для Каждого ИмяКолонки Из Таблица.Колонки Цикл
		Разделитель.Добавить("---");
	КонецЦикла;
	Части.Добавить("| " + СтрСоединить(Разделитель, " | ") + " |");
	Для Каждого СтрокаТаблицы Из Таблица.Строки Цикл
		Ячейки = Новый Массив;
		Для Каждого ИмяКолонки Из Таблица.Колонки Цикл
			Ячейки.Добавить(Строка(СтрокаТаблицы[ИмяКолонки]));
		КонецЦикла;
		Части.Добавить("| " + СтрСоединить(Ячейки, " | ") + " |");
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

Функция КакСоответствие(Значение)

	Результат = Новый Соответствие;
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Для Каждого КлючЗначение Из Значение Цикл
			Результат.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Успех(Тело)

	Возврат Новый Структура("КодСостояния,Тело", 200, Тело);

КонецФункции

Функция Ошибка(КодСостояния, КодОшибки, Подробность)

	Возврат Новый Структура("КодСостояния,КодОшибки,Подробность", КодСостояния, КодОшибки, Подробность);

КонецФункции

#КонецОбласти
