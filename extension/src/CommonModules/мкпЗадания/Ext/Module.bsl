#Область ПрограммныйИнтерфейс

Функция Поставить(Операция, ТелоJSON, Клиент) Экспорт

	Если Операция = "action" Тогда
		Возврат Новый Структура("КодСостояния,КодОшибки,Подробность",
			501, "not_implemented", "Вызов действий — фаза 3.");
	КонецЕсли;
	Если Операция = "query" Тогда
		Исполнение = мкпЗапросы.ВыполнитьПоТелу(ТелоJSON);
	ИначеЕсли Операция = "report" Тогда
		Исполнение = мкпОтчёты.ВыполнитьПоТелу(ТелоJSON);
	Иначе
		Возврат Новый Структура("КодСостояния,КодОшибки,Подробность",
			400, "bad_request", "operation: query или report");
	КонецЕсли;
	Если Исполнение.Свойство("КодОшибки") Тогда
		Возврат Исполнение;
	КонецЕсли;
	Ид = Строка(Новый УникальныйИдентификатор);
	Записать(Ид, Операция, "succeeded", мкпСериализация.ВJSON(Исполнение.Тело), "", Клиент);
	Принято = Новый Структура("job_id,status", Ид, "queued");
	Возврат Новый Структура("КодСостояния,Тело", 202, Принято);

КонецФункции

Функция Получить(Ид, Клиент) Экспорт

	Менеджер = РегистрыСведений.мкпСостоянияЗаданий.СоздатьМенеджерЗаписи();
	Менеджер.Идентификатор = Строка(Ид);
	Менеджер.Прочитать();
	Если Не Менеджер.Выбран() Или Менеджер.Клиент <> Клиент Тогда
		Возврат Новый Структура("КодСостояния,КодОшибки,Подробность",
			404, "not_found", "Задание не найдено");
	КонецЕсли;
	Тело = Новый Структура("job_id,status,operation", Менеджер.Идентификатор, Менеджер.Статус, Менеджер.Операция);
	Если ЗначениеЗаполнено(Менеджер.Момент) Тогда
		Тело.Вставить("at", Формат(Менеджер.Момент, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z");
	КонецЕсли;
	Если Не ПустаяСтрока(Менеджер.РезультатJSON) Тогда
		Тело.Вставить("result", мкпСериализация.ИзJSON(Менеджер.РезультатJSON));
	КонецЕсли;
	Если Не ПустаяСтрока(Менеджер.ОшибкаJSON) Тогда
		Тело.Вставить("error", мкпСериализация.ИзJSON(Менеджер.ОшибкаJSON));
	КонецЕсли;
	Возврат Новый Структура("КодСостояния,Тело", 200, Тело);

КонецФункции

Функция СписокКлиента(Клиент, ПараметрыЗапроса) Экспорт

	Лимит = 50;
	Статус = "";
	Если ПараметрыЗапроса <> Неопределено Тогда
		СыройЛимит = ПараметрыЗапроса.Получить("limit");
		Если СыройЛимит <> Неопределено Тогда
			Лимит = Число(СыройЛимит);
		КонецЕсли;
		ЗначениеСтатуса = ПараметрыЗапроса.Получить("status");
		Если ЗначениеСтатуса <> Неопределено Тогда
			Статус = Строка(ЗначениеСтатуса);
		КонецЕсли;
	КонецЕсли;
	Если Лимит < 1 Тогда
		Лимит = 1;
	КонецЕсли;
	Если Лимит > 200 Тогда
		Лимит = 200;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задания.Идентификатор КАК Идентификатор,
	|	Задания.Статус КАК Статус,
	|	Задания.Операция КАК Операция,
	|	Задания.Момент КАК Момент
	|ИЗ
	|	РегистрСведений.мкпСостоянияЗаданий КАК Задания
	|ГДЕ
	|	Задания.Клиент = &Клиент
	|
	|УПОРЯДОЧИТЬ ПО
	|	Момент УБЫВ";
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	Элементы = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Элементы.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Если Не ПустаяСтрока(Статус) И Строка(Выборка.Статус) <> Статус Тогда
			Продолжить;
		КонецЕсли;
		СтрокаЗадания = Новый Структура;
		СтрокаЗадания.Вставить("job_id", Строка(Выборка.Идентификатор));
		СтрокаЗадания.Вставить("status", Строка(Выборка.Статус));
		СтрокаЗадания.Вставить("operation", Строка(Выборка.Операция));
		СтрокаЗадания.Вставить("at", Формат(Выборка.Момент, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z");
		Элементы.Добавить(СтрокаЗадания);
	КонецЦикла;
	Страница = Новый Структура;
	Страница.Вставить("content_kind", "data");
	Страница.Вставить("items", Элементы);
	Возврат Страница;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Записать(Ид, Операция, Статус, РезультатJSON, ОшибкаJSON, Клиент)

	Менеджер = РегистрыСведений.мкпСостоянияЗаданий.СоздатьМенеджерЗаписи();
	Менеджер.Идентификатор = Ид;
	Менеджер.Операция = Операция;
	Менеджер.Статус = Статус;
	Менеджер.РезультатJSON = РезультатJSON;
	Менеджер.ОшибкаJSON = ОшибкаJSON;
	Менеджер.Клиент = Клиент;
	Менеджер.Момент = ТекущаяДатаСеанса();
	Менеджер.Записать();

КонецПроцедуры

#КонецОбласти
