#Область ПрограммныйИнтерфейс

// Обрабатывает входящий запрос HTTP-сервиса мкпAPI.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция ОбработатьЗапрос(Запрос) Экспорт

	Метод = ВРег(Запрос.HTTPМетод);
	Путь = НормализоватьПуть(Запрос.ОтносительныйURL);

	Если Метод = "GET" И Путь = "/v1/health" Тогда
		Возврат ОтветHealth();
	КонецЕсли;

	Возврат ОтветОшибка(
		501,
		"not_implemented",
		"Операция описана в контракте v1 и будет реализована в следующей фазе.");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтветHealth()

	Тело = Новый Структура;
	Тело.Вставить("status", "ok");
	Тело.Вставить("service", "1cmcp");
	Тело.Вставить("version", ВерсияРасширения());
	Тело.Вставить("api", "v1");
	Тело.Вставить("time", ФорматUTC(ТекущаяУниверсальнаяДата()));

	Возврат ОтветJSON(200, Тело, "application/json; charset=utf-8");

КонецФункции

Функция ВерсияРасширения()

	Возврат "0.1.0";

КонецФункции

Функция НормализоватьПуть(Знач Путь)

	Если Путь = Неопределено Тогда
		Возврат "/";
	КонецЕсли;

	Результат = СокрЛП(Строка(Путь));
	Если СтрДлина(Результат) = 0 Тогда
		Возврат "/";
	КонецЕсли;

	Если Не СтрНачинаетсяС(Результат, "/") Тогда
		Результат = "/" + Результат;
	КонецЕсли;

	Пока СтрЗаканчиваетсяНа(Результат, "/") И СтрДлина(Результат) > 1 Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ФорматUTC(Знач ДатаUTC)

	Возврат Формат(ДатаUTC, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z";

КонецФункции

Функция ОтветJSON(КодСостояния, Значение, ТипСодержимого)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Текст = Запись.Закрыть();

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", ТипСодержимого);
	Ответ.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Возврат Ответ;

КонецФункции

Функция ОтветОшибка(КодСостояния, КодОшибки, Подробность)

	Тело = Новый Структура;
	Тело.Вставить("type", "https://1cmcp.dev/errors/" + КодОшибки);
	Тело.Вставить("title", ЗаголовокОшибки(КодСостояния));
	Тело.Вставить("status", КодСостояния);
	Тело.Вставить("detail", Подробность);
	Тело.Вставить("code", КодОшибки);

	Возврат ОтветJSON(КодСостояния, Тело, "application/problem+json; charset=utf-8");

КонецФункции

Функция ЗаголовокОшибки(КодСостояния)

	Если КодСостояния = 501 Тогда
		Возврат "Not implemented";
	ИначеЕсли КодСостояния = 404 Тогда
		Возврат "Not found";
	ИначеЕсли КодСостояния = 401 Тогда
		Возврат "Unauthorized";
	ИначеЕсли КодСостояния = 403 Тогда
		Возврат "Forbidden";
	КонецЕсли;

	Возврат "Error";

КонецФункции

#КонецОбласти
