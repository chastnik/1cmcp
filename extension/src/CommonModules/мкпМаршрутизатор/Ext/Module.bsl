#Область ПрограммныйИнтерфейс

// Обрабатывает входящий запрос HTTP-сервиса мкпAPI.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция ОбработатьЗапрос(Запрос) Экспорт

	НачалоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Метод = ВРег(Запрос.HTTPМетод);
	Путь = НормализоватьПуть(Запрос.ОтносительныйURL);

	Если Метод = "GET" И Путь = "/v1/health" Тогда
		Возврат ОтветHealth();
	КонецЕсли;

	Если Метод = "GET" И Путь = "/v1/diag" Тогда
		Возврат ОтветDiag();
	КонецЕсли;

	Клиент = мкпБезопасность.КлиентПоЗапросу(Запрос);
	Если Клиент = Неопределено Тогда
		Возврат ОтветОшибка(401, "unauthorized", "Требуется действительный Bearer-токен");
	КонецЕсли;
	НужныйСкоуп = СкоупДляПути(Метод, Путь);
	Если Не мкпБезопасность.ЕстьСкоуп(Клиент, НужныйСкоуп) Тогда
		Возврат ОтветОшибка(403, "forbidden", "Недостаточно прав");
	КонецЕсли;

	Ответ = Маршрутизировать(Метод, Путь, Запрос, Клиент);
	ЗаписатьЖурналБезопасно(Клиент, Метод, Путь, Ответ, НачалоМс);
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Маршрутизировать(Метод, Путь, Запрос, Клиент)

	Если Метод = "GET" И Путь = "/v1/meta" Тогда
		Возврат ОтветДанные(мкпИнтроспекция.СписокТипов(Запрос.ПараметрыЗапроса));
	КонецЕсли;

	Если Метод = "GET" И Путь = "/v1/meta/search" Тогда
		Возврат ОтветДанные(мкпИнтроспекция.ПоискСемантики(Запрос.ПараметрыЗапроса));
	КонецЕсли;

	Если Метод = "GET" И СтрНачинаетсяС(Путь, "/v1/meta/") Тогда
		Части = СтрРазделить(Сред(Путь, СтрДлина("/v1/meta/") + 1), "/", Ложь);
		Если Части.Количество() = 2 Тогда
			Вид = Части[0];
			Имя = Части[1];
			Если мкпБезопасность.ЭтоСлужебныйОбъект(Имя) Тогда
				Возврат ОтветОшибка(404, "not_found", "Нет объекта " + Вид + "/" + Имя);
			КонецЕсли;
			Если Не мкпБезопасность.Разрешено(Клиент, Вид, Имя, "read") Тогда
				Возврат ОтветОшибка(403, "forbidden", "Нет доступа к объекту");
			КонецЕсли;
			Описание = мкпИнтроспекция.ОписаниеТипа(Вид, Имя);
			Если Описание = Неопределено Тогда
				Возврат ОтветОшибка(404, "not_found", "Нет объекта " + Вид + "/" + Имя);
			КонецЕсли;
			Возврат ОтветДанные(Описание);
		КонецЕсли;
	КонецЕсли;

	Если Метод = "GET" И СтрНачинаетсяС(Путь, "/v1/data/") Тогда
		Части = СтрРазделить(Сред(Путь, СтрДлина("/v1/data/") + 1), "/", Ложь);
		Если Части.Количество() >= 2 Тогда
			Вид = Части[0];
			Имя = Части[1];
			Если мкпБезопасность.ЭтоСлужебныйОбъект(Имя) Тогда
				Возврат ОтветОшибка(404, "not_found", "Нет выборки " + Вид + "/" + Имя);
			КонецЕсли;
			Если Не мкпБезопасность.Разрешено(Клиент, Вид, Имя, "read") Тогда
				Возврат ОтветОшибка(403, "forbidden", "Нет доступа к объекту");
			КонецЕсли;
			Если Части.Количество() = 2 Тогда
				Страница = мкпДанные.Список(Вид, Имя, Запрос.ПараметрыЗапроса);
				Если Страница = Неопределено Тогда
					Возврат ОтветОшибка(404, "not_found", "Нет выборки " + Вид + "/" + Имя);
				КонецЕсли;
				Возврат ОтветДанные(Страница);
			ИначеЕсли Части.Количество() = 3 Тогда
				Объект = мкпДанные.ПолучитьПоИд(Вид, Имя, Части[2]);
				Если Объект = Неопределено Тогда
					Возврат ОтветОшибка(404, "not_found", "Объект не найден");
				КонецЕсли;
				Возврат ОтветДанные(Объект);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Метод = "POST" И Путь = "/v1/query" Тогда
		Если Асинхронно(Запрос) Тогда
			Возврат ОтветИсполнения(мкпЗадания.Поставить("query", Запрос.ПолучитьТелоКакСтроку()));
		КонецЕсли;
		Возврат ОтветИсполнения(мкпЗапросы.ВыполнитьПоТелу(Запрос.ПолучитьТелоКакСтроку()));
	КонецЕсли;
	Если Метод = "POST" И Путь = "/v1/report" Тогда
		Если Асинхронно(Запрос) Тогда
			Возврат ОтветИсполнения(мкпЗадания.Поставить("report", Запрос.ПолучитьТелоКакСтроку()));
		КонецЕсли;
		Возврат ОтветИсполнения(мкпОтчёты.ВыполнитьПоТелу(Запрос.ПолучитьТелоКакСтроку()));
	КонецЕсли;
	Если Метод = "POST" И Путь = "/v1/job" Тогда
		Возврат ОтветЗаданияПостановки(Запрос);
	КонецЕсли;
	Если Метод = "GET" И СтрНачинаетсяС(Путь, "/v1/job/") Тогда
		Ид = Сред(Путь, СтрДлина("/v1/job/") + 1);
		Возврат ОтветИсполнения(мкпЗадания.Получить(Ид));
	КонецЕсли;

	Если (Метод = "POST" Или Метод = "PATCH") И СтрНачинаетсяС(Путь, "/v1/data/") Тогда
		Возврат ОтветЗаписиДанных(Метод, Путь, Запрос, Клиент);
	КонецЕсли;
	Если Метод = "POST" И Путь = "/v1/action" Тогда
		Возврат ОтветИсполнения(мкпДействия.ВыполнитьПоТелу(Запрос.ПолучитьТелоКакСтроку(), Запрос, Клиент));
	КонецЕсли;
	Если Метод = "POST" И Путь = "/v1/session/rollback" Тогда
		Возврат ОтветИсполнения(мкпДанные.ОткатитьСессию(Запрос.ПолучитьТелоКакСтроку(), Запрос, Клиент));
	КонецЕсли;
	Если Метод = "GET" И Путь = "/v1/audit" Тогда
		Возврат ОтветДанные(мкпБезопасность.ЖурналКлиента(Клиент, Запрос.ПараметрыЗапроса));
	КонецЕсли;

	Возврат ОтветОшибка(
		501,
		"not_implemented",
		"Операция описана в контракте v1 и будет реализована в следующей фазе.");

КонецФункции

Функция ОтветHealth()

	Тело = Новый Структура;
	Тело.Вставить("status", "ok");
	Тело.Вставить("service", "1cmcp");
	Тело.Вставить("version", мкпСериализация.ВерсияРасширения());
	Тело.Вставить("api", "v1");
	Тело.Вставить("time", ФорматUTC(ТекущаяУниверсальнаяДата()));

	Возврат ОтветJSON(200, Тело, "application/json; charset=utf-8");

КонецФункции

Функция ОтветDiag()

	Тело = Новый Структура;
	Тело.Вставить("status", "ok");
	Тело.Вставить("service", "1cmcp");
	Тело.Вставить("version", мкпСериализация.ВерсияРасширения());
	Тело.Вставить("api", "v1");
	Тело.Вставить("time", ФорматUTC(ТекущаяУниверсальнаяДата()));
	Тело.Вставить("product_license", "not_required");

	Совместимость = Новый Структура;
	Совместимость.Вставить("platform", "8.3.20+");
	Режимы = Новый Массив;
	Режимы.Добавить("file");
	Режимы.Добавить("client_server");
	Совместимость.Вставить("modes", Режимы);
	Тело.Вставить("compatibility", Совместимость);

	Публикация = Новый Структура;
	Публикация.Вставить("root_url", "mcp");
	Публикация.Вставить("reuse_sessions", "AutoUse");
	Публикация.Вставить("session_max_age", 20);
	Тело.Вставить("publication", Публикация);

	Проверки = Новый Массив;
	Проверки.Добавить(ПунктДиагностики("http_service", Истина, "RootURL mcp"));
	Проверки.Добавить(ПунктДиагностики("session_reuse", Истина, "AutoUse, SessionMaxAge=20"));
	Проверки.Добавить(ПунктДиагностики("role", Истина, "мкпДоступКоннектора"));
	Проверки.Добавить(ПунктДиагностики("product_license", Истина, "not_required"));
	Тело.Вставить("checks", Проверки);

	Возврат ОтветJSON(200, Тело, "application/json; charset=utf-8");

КонецФункции

Функция ПунктДиагностики(Идентификатор, Успех, Подробность)

	Пункт = Новый Структура;
	Пункт.Вставить("id", Идентификатор);
	Пункт.Вставить("ok", Успех);
	Пункт.Вставить("detail", Подробность);
	Возврат Пункт;

КонецФункции

Функция СкоупДляПути(Метод, Путь)

	Если Метод = "PATCH" Или Метод = "PUT" Или Метод = "DELETE" Тогда
		Возврат "write";
	КонецЕсли;
	Если Метод = "POST" Тогда
		Если Путь = "/v1/query" Или Путь = "/v1/report" Или Путь = "/v1/job" Тогда
			Возврат "read";
		КонецЕсли;
		Возврат "write";
	КонецЕсли;
	Возврат "read";

КонецФункции

Функция ОтветЗаписиДанных(Метод, Путь, Запрос, Клиент)

	Части = СтрРазделить(Сред(Путь, СтрДлина("/v1/data/") + 1), "/", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат ОтветОшибка(404, "not_found", "Нет объекта");
	КонецЕсли;
	Вид = Части[0];
	Имя = Части[1];
	Если мкпБезопасность.ЭтоСлужебныйОбъект(Имя) Тогда
		Возврат ОтветОшибка(404, "not_found", "Нет объекта " + Вид + "/" + Имя);
	КонецЕсли;
	Если Не мкпБезопасность.Разрешено(Клиент, Вид, Имя, "write") Тогда
		Возврат ОтветОшибка(403, "forbidden", "Нет доступа на запись");
	КонецЕсли;
	Тело = Запрос.ПолучитьТелоКакСтроку();
	Если Метод = "POST" И Части.Количество() = 3 И Части[2] = "dry-run" Тогда
		Возврат ОтветИсполнения(мкпДанные.Предпросмотр(Вид, Имя, Тело, Клиент));
	КонецЕсли;
	Если Метод = "POST" И Части.Количество() = 2 Тогда
		Возврат ОтветИсполнения(мкпДанные.Создать(Вид, Имя, Тело, Запрос, Клиент));
	КонецЕсли;
	Если Метод = "PATCH" И Части.Количество() = 3 Тогда
		Возврат ОтветИсполнения(мкпДанные.Изменить(Вид, Имя, Части[2], Тело, Запрос, Клиент));
	КонецЕсли;
	Если Метод = "POST" И Части.Количество() = 4 И Части[3] = "post" Тогда
		Возврат ОтветИсполнения(мкпДанные.Провести(Вид, Имя, Части[2], Тело, Запрос, Клиент));
	КонецЕсли;
	Возврат ОтветОшибка(
		501,
		"not_implemented",
		"Операция описана в контракте v1 и будет реализована в следующей фазе.");

КонецФункции

Функция НормализоватьПуть(Знач Путь)

	Если Путь = Неопределено Тогда
		Возврат "/";
	КонецЕсли;

	Результат = СокрЛП(Строка(Путь));
	Если СтрДлина(Результат) = 0 Тогда
		Возврат "/";
	КонецЕсли;

	Если Не СтрНачинаетсяС(Результат, "/") Тогда
		Результат = "/" + Результат;
	КонецЕсли;

	Пока СтрЗаканчиваетсяНа(Результат, "/") И СтрДлина(Результат) > 1 Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ФорматUTC(Знач ДатаUTC)

	Возврат Формат(ДатаUTC, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z";

КонецФункции

Функция ОтветДанные(Значение)

	Ответ = ОтветJSON(200, Значение, "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("X-1cmcp-Content-Kind", "data");
	Возврат Ответ;

КонецФункции

Функция Асинхронно(Запрос)

	Тело = Запрос.ПолучитьТелоКакСтроку();
	Если ПустаяСтрока(СокрЛП(Строка(Тело))) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Данные = мкпСериализация.ИзJSON(Тело);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Флаг = Неопределено;
		Данные.Свойство("async", Флаг);
		Возврат Флаг = Истина;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Возврат Данные.Получить("async") = Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция ОтветИсполнения(Исполнение)

	Если Исполнение.Свойство("КодОшибки") Тогда
		Возврат ОтветОшибка(Исполнение.КодСостояния, Исполнение.КодОшибки, Исполнение.Подробность);
	КонецЕсли;
	Код = Исполнение.КодСостояния;
	Если Код = 200 Тогда
		Возврат ОтветДанные(Исполнение.Тело);
	КонецЕсли;
	Возврат ОтветJSON(Код, Исполнение.Тело, "application/json; charset=utf-8");

КонецФункции

Функция ОтветЗаданияПостановки(Запрос)

	Тело = Запрос.ПолучитьТелоКакСтроку();
	Попытка
		Данные = мкпСериализация.ИзJSON(Тело);
	Исключение
		Возврат ОтветОшибка(400, "bad_request", "Некорректный JSON");
	КонецПопытки;
	Операция = "";
	Нагрузка = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные.Свойство("operation", Операция);
		Данные.Свойство("payload", Нагрузка);
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Операция = Данные.Получить("operation");
		Нагрузка = Данные.Получить("payload");
	КонецЕсли;
	ТекстНагрузки = "{}";
	Если Нагрузка <> Неопределено Тогда
		ТекстНагрузки = мкпСериализация.ВJSON(Нагрузка);
	КонецЕсли;
	Возврат ОтветИсполнения(мкпЗадания.Поставить(Строка(Операция), ТекстНагрузки));

КонецФункции

Функция ОтветJSON(КодСостояния, Значение, ТипСодержимого)

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", ТипСодержимого);
	Ответ.УстановитьТелоИзСтроки(
		мкпСериализация.ВJSON(Значение),
		КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции

Функция ОтветОшибка(КодСостояния, КодОшибки, Подробность)

	Тело = Новый Структура;
	Тело.Вставить("type", "https://1cmcp.dev/errors/" + КодОшибки);
	Тело.Вставить("title", ЗаголовокОшибки(КодСостояния));
	Тело.Вставить("status", КодСостояния);
	Тело.Вставить("detail", Подробность);
	Тело.Вставить("code", КодОшибки);

	Возврат ОтветJSON(КодСостояния, Тело, "application/problem+json; charset=utf-8");

КонецФункции

Функция ЗаголовокОшибки(КодСостояния)

	Если КодСостояния = 501 Тогда
		Возврат "Not implemented";
	ИначеЕсли КодСостояния = 404 Тогда
		Возврат "Not found";
	ИначеЕсли КодСостояния = 401 Тогда
		Возврат "Unauthorized";
	ИначеЕсли КодСостояния = 403 Тогда
		Возврат "Forbidden";
	ИначеЕсли КодСостояния = 400 Тогда
		Возврат "Bad request";
	ИначеЕсли КодСостояния = 409 Тогда
		Возврат "Conflict";
	ИначеЕсли КодСостояния = 422 Тогда
		Возврат "Unprocessable entity";
	КонецЕсли;

	Возврат "Error";

КонецФункции

Процедура ЗаписатьЖурналБезопасно(Клиент, Метод, Путь, Ответ, НачалоМс)

	Попытка
		Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс;
		СсылкиJSON = СсылкиИзОтвета(Ответ);
		мкпБезопасность.ЗаписатьВызов(Клиент, Метод, Путь, Ответ.КодСостояния, Длительность, СсылкиJSON);
	Исключение
		// Журнал не должен ломать ответ агенту.
	КонецПопытки;

КонецПроцедуры

Функция СсылкиИзОтвета(Ответ)

	Попытка
		Тело = Ответ.ПолучитьТелоКакСтроку();
		Данные = мкпСериализация.ИзJSON(Тело);
	Исключение
		Возврат "";
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Ссылка = Данные.Получить("ref");
	Если Ссылка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Массив = Новый Массив;
	Массив.Добавить(Ссылка);
	Возврат мкпСериализация.ВJSON(Массив);

КонецФункции

#КонецОбласти
