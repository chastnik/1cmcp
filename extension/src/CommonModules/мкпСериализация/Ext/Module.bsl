#Область ПрограммныйИнтерфейс

Функция ВерсияРасширения() Экспорт

	Возврат "0.7.0";

КонецФункции

Функция ВJSON(Значение) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция ИзJSON(Текст) Экспорт

	Если Текст = Неопределено Или ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Возврат ПрочитатьJSON(Чтение, Истина);

КонецФункции

Функция ХешТокена(Токен) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Токен);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

Функция СсылкаВJSON(Значение) Экспорт

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("ref", Значение.Метаданные().ПолноеИмя());
	Результат.Вставить("id", Строка(Значение.УникальныйИдентификатор()));
	Результат.Вставить("presentation", Строка(Значение));
	Возврат Результат;

КонецФункции

Функция ДатаВJSON(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Час(Значение) = 0 И Минута(Значение) = 0 И Секунда(Значение) = 0 Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-dd");
	КонецЕсли;
	Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z";

КонецФункции

Функция ЗначениеВJSON(Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Дата") Тогда
		Возврат ДатаВJSON(Значение);
	ИначеЕсли ЭтоСсылка(Значение) Тогда
		Возврат СсылкаВJSON(Значение);
	ИначеЕсли ТипЗначения = Тип("ХранилищеЗначения") Или ТипЗначения = Тип("ДвоичныеДанные") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ИмяМетаданныхБезопасно(Имя) Экспорт

	Если Имя = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	СтрокаИмени = СокрЛП(Строка(Имя));
	Если СтрДлина(СтрокаИмени) = 0 Или СтрДлина(СтрокаИмени) > 255 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(СтрокаИмени) Цикл
		Символ = Сред(СтрокаИмени, Индекс, 1);
		Код = КодСимвола(Символ);
		Буква = (Код >= 65 И Код <= 90) Или (Код >= 97 И Код <= 122)
			Или (Код >= 1040 И Код <= 1103) Или Код = 1025 Или Код = 1105;
		Цифра = Код >= 48 И Код <= 57;
		Если Не (Буква Или Цифра Или Символ = "_") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоСсылка(Значение)

	Попытка
		Мета = Значение.Метаданные();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Мета <> Неопределено;

КонецФункции

#КонецОбласти
