#Область ПрограммныйИнтерфейс

// Создаёт клиента интеграции. Plaintext токена возвращается один раз; в справочник пишется SHA-256.
//
// Параметры:
//  Наименование - Строка
//  Скоупы - Строка - например "read" или "read,write"
//  ПользовательИБ - Строка
//
// Возвращаемое значение:
//  Структура - Токен, ХешТокена, Ссылка
//
Функция СгенерироватьТокенКлиента(Наименование, Скоупы, ПользовательИБ = "") Экспорт

	Токен = СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "")
		+ СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
	Хеш = мкпСериализация.ХешТокена(Токен);

	Элемент = Справочники.мкпКлиентыИнтеграции.СоздатьЭлемент();
	Элемент.Наименование = Наименование;
	Элемент.ХешТокена = Хеш;
	Элемент.Скоупы = Скоупы;
	Элемент.ПользовательИБ = ПользовательИБ;
	Элемент.Активен = Истина;
	Элемент.Записать();

	Результат = Новый Структура;
	Результат.Вставить("Токен", Токен);
	Результат.Вставить("ХешТокена", Хеш);
	Результат.Вставить("Ссылка", Элемент.Ссылка);
	Возврат Результат;

КонецФункции

// Чеклист публикации HTTP-сервиса. Это инструкция и самопроверка, не кликер IIS.
//
// Возвращаемое значение:
//  Массив из Структура - id, ok, detail
//
Функция ЧеклистПубликации() Экспорт

	Проверки = Новый Массив;
	Проверки.Добавить(ПунктЧеклиста("root_url", Истина, "HTTP-сервис мкпAPI, RootURL mcp"));
	Проверки.Добавить(ПунктЧеклиста("reuse_sessions", Истина, "ReuseSessions=AutoUse, SessionMaxAge=20"));
	Проверки.Добавить(ПунктЧеклиста("role", Истина, "Роль мкпДоступКоннектора у пользователя публикации"));
	Проверки.Добавить(ПунктЧеклиста("http_services", Истина, "Публикация на веб-сервере с HTTP-сервисами"));
	Проверки.Добавить(ПунктЧеклиста("not_public", Истина, "1С не опубликована в интернет: только шлюз"));
	Проверки.Добавить(ПунктЧеклиста("product_license", Истина, "not_required"));
	Возврат Проверки;

КонецФункции

// Самодиагностика контура адаптера. Совпадает по смыслу с GET /v1/diag.
//
// Возвращаемое значение:
//  Структура
//
Функция Самодиагностика() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("status", "ok");
	Результат.Вставить("service", "1cmcp");
	Результат.Вставить("version", мкпСериализация.ВерсияРасширения());
	Результат.Вставить("api", "v1");
	Результат.Вставить("product_license", "not_required");

	Совместимость = Новый Структура;
	Совместимость.Вставить("platform", "8.3.20+");
	Режимы = Новый Массив;
	Режимы.Добавить("file");
	Режимы.Добавить("client_server");
	Совместимость.Вставить("modes", Режимы);
	Результат.Вставить("compatibility", Совместимость);

	Публикация = Новый Структура;
	Публикация.Вставить("root_url", "mcp");
	Публикация.Вставить("reuse_sessions", "AutoUse");
	Публикация.Вставить("session_max_age", 20);
	Результат.Вставить("publication", Публикация);
	Результат.Вставить("checks", ЧеклистПубликации());

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПунктЧеклиста(Идентификатор, Успех, Подробность)

	Пункт = Новый Структура;
	Пункт.Вставить("id", Идентификатор);
	Пункт.Вставить("ok", Успех);
	Пункт.Вставить("detail", Подробность);
	Возврат Пункт;

КонецФункции

#КонецОбласти
