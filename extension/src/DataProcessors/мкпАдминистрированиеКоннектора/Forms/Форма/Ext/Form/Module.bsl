#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СгенерироватьТокен(Команда)

	Если ПустаяСтрока(НаименованиеКлиента) Тогда
		ПоказатьПредупреждение(, "Укажите наименование клиента интеграции");
		Возврат;
	КонецЕсли;
	Результат = СгенерироватьТокенНаСервере();
	ПоказатьПредупреждение(,
		"Токен вставьте в веб-консоль шлюза (Администрирование → Базы 1С). Дальше в базе только SHA-256:"
		+ Символы.ПС + Результат.Токен);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЧеклистПубликации(Команда)

	Текст = ЧеклистПубликацииНаСервере();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьСамодиагностику(Команда)

	Текст = СамодиагностикаНаСервере();
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СгенерироватьТокенНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.СгенерироватьТокенКлиента(НаименованиеКлиента, СкоупыКлиента, ПользовательИБ);

КонецФункции

&НаСервере
Функция ЧеклистПубликацииНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Части = Новый Массив;
	Для Каждого Пункт Из ОбработкаОбъект.ЧеклистПубликации() Цикл
		Части.Добавить(Строка(Пункт.id) + ": " + Строка(Пункт.detail));
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

&НаСервере
Функция СамодиагностикаНаСервере()

	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Данные = ОбработкаОбъект.Самодиагностика();
	Возврат "status=" + Данные.status + ", version=" + Данные.version
		+ ", product_license=" + Данные.product_license;

КонецФункции

#КонецОбласти
